{
  "name": "gestor-tiempo",
  "private": true,
  "version": "0.10.0",
  "description": "Gestor de tiempo: tareas, calendario, proyectos y temporizador de foco.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "start": "node server.cjs",
    "desktop": "npm run build && electron .",
    "installer": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^14.14.0",
    "globals": "^17.14.0",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.gestortiempo",
    "productName": "Gestor tiempo",
    "files": [
      "dist/**",
      "server.cjs",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gestor tiempo",
      "artifactName": "GestorTiempo-Setup-${version}.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexlo3223/Gestion-temporal.git"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "react-day-picker": "^10.0.2",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  }
}
