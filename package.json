{
  "name": "gestor-tiempo",
  "private": true,
  "version": "0.8.0",
  "description": "Gestor de tiempo: tareas, calendario, proyectos y temporizador de foco.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "start": "node server.cjs",
    "desktop": "npm run build && electron .",
    "exe": "npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^14.14.0",
    "globals": "^17.14.0",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.gestortiempo",
    "productName": "Gestor tiempo",
    "files": [
      "dist/**",
      "server.cjs",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "GestorTiempo.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexlo3223/Gestion-temporal.git"
  }
}
